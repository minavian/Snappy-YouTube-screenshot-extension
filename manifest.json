{
  "manifest_version": 3,
  "name": "Snappy! Screenshot for YouTube",
  "version": "1.2",
  "description": "Captures frames with customizable file formats and resolution limits.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "Picture3.png"
  },
  "icons": {
    "16": "Picture3.png",
    "48": "Picture3.png",
    "128": "Picture3.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}