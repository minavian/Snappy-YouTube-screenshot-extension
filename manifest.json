{
  "manifest_version": 3,
  "name": "Snappy: YouTube Screenshot",
  "version": "1.3",
  "description": "Snap YouTube and Shorts frames in one click as JPEG, PNG or WebP. Force max limit snaps from the sharpest stream, even in 360p.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "Picture3.png"
  },
  "icons": {
    "16": "Picture3.png",
    "48": "Picture3.png",
    "128": "Picture3.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_end"
    }
  ]
}